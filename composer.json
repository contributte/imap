{
  "name": "minetro/imap",
  "description": "Simple IMAP wrapper",
  "type": "library",
  "license": ["BSD-3-Clause"],
  "homepage": "https://github.com/minetro/imap",
  "authors": [
    {
      "name": "Milan Felix Sulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "contributte/phpstan": "~0.2.0",
    "contributte/qa": "~0.4.0",
    "contributte/tester": "~0.3.0"
  },
  "autoload": {
    "psr-4": {
      "Minetro\\Imap\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
